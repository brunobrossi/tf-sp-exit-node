{
  "acls": [
    {
      "action": "accept",
      "src": [
        "autogroup:member",
        "autogroup:tagged"
      ],
      "dst": [
        "*:*"
      ]
    }
  ],
  "tagOwners": {
    "tag:exit-node": ["autogroup:admin"],
    "tag:home-server": ["autogroup:admin"]
  },
  "autoApprovers": {
    "exitNode": [
      "tag:exit-node"
    ]
  },
  "ssh": [
    {
      "action": "accept",
      "src": [
        "autogroup:member"
      ],
      "dst": [
        "autogroup:self",
        "tag:exit-node"
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ]
    }
  ]
}
